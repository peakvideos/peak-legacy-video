# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored.

# Public site URL (used for absolute links, OAuth callbacks, etc.)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Set to "true" on staging/preview deploys to add a sitewide noindex robots rule.
# Leave empty (or set to "false") in production.
NEXT_PUBLIC_NOINDEX=true

# Postgres on Railway
DATABASE_URL=postgres://user:password@host:5432/railway

# BetterAuth (owner CRM auth)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Owner allowlist — comma-separated emails permitted to sign into /admin.
# Account creation is rejected for any address not on this list.
OWNER_EMAILS=peaklegacyvideos@gmail.com,eppler97@gmail.com

# Bootstrap toggle. Set to "true" only long enough to create the owner
# account (via /sign-in or `pnpm db:seed`), then unset. While unset, Better
# Auth's signup endpoint is disabled — only existing users can sign in.
# After signup, manually mark the row as admin in Postgres:
#   UPDATE users SET role='admin' WHERE email='<owner email>';
ALLOW_SIGNUP=

# Gmail SMTP (booking confirmations + drip sequence)
# Owner generates an App Password at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification enabled). Personal Gmail = ~500 sends/day.
GMAIL_SMTP_USER=peaklegacyvideos@gmail.com
GMAIL_SMTP_PASSWORD=
EMAIL_FROM="Peak Studios CO <peaklegacyvideos@gmail.com>"
OWNER_NOTIFICATION_EMAIL=peaklegacyvideos@gmail.com

# Cron secret for /api/cron/email-jobs — Vercel Cron sends this as a Bearer token.
# Generate with: openssl rand -base64 32
CRON_SECRET=

# Google Calendar API (server-side, OAuth 2.0)
# Owner provides via Google Cloud Console — Phase 3
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Meta Pixel (client-side; safe to expose)
NEXT_PUBLIC_META_PIXEL_ID=
